{
  "sourceLanguage": "en",
  "strings": {
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to your self-hosted Memoh server on your local network."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接本地网络上的 Memoh 服务器。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate a tu servidor Memoh en la red local."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワーク上のMemohサーバーに接続します。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record a voice message to attach to your conversation with a Memoh agent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制语音消息，发送给 Memoh 智能体。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba un mensaje de voz para enviarlo a un agente de Memoh."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Memohエージェントに送る音声メッセージを録音します。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homem’s video library supports camera capture, but this version only displays remote video and does not access your camera."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Homem 的视频库支持摄像头采集，但此版本仅显示远程画面，不会使用摄像头。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La biblioteca de vídeo admite cámara, pero esta versión solo muestra vídeo remoto y no accede a tu cámara."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映像ライブラリはカメラ機能に対応していますが、このバージョンはリモート映像の表示のみで、カメラは使用しません。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
